<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LoggerBuddy"
            android:textColor="#F3F4F6"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A tiny developer console for Android apps"
            android:textColor="#9CA3AF"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Write a custom log message"
            android:textColor="#F3F4F6"
            android:textColorHint="#6B7280"
            android:backgroundTint="#3B82F6"
            android:singleLine="false"
            android:minLines="2" />

        <EditText
            android:id="@+id/tagEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Tag, example: MainActivity"
            android:textColor="#F3F4F6"
            android:textColorHint="#6B7280"
            android:backgroundTint="#3B82F6"
            android:singleLine="true" />

        <RadioGroup
            android:id="@+id/levelRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/infoRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFO"
                android:textColor="#22C55E"
                android:checked="true" />

            <RadioButton
                android:id="@+id/warningRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARNING"
                android:textColor="#F59E0B" />

            <RadioButton
                android:id="@+id/errorRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ERROR"
                android:textColor="#EF4444" />

            <RadioButton
                android:id="@+id/debugRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEBUG"
                android:textColor="#3B82F6" />
        </RadioGroup>

        <Button
            android:id="@+id/addLogButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Add Log" />

        <Button
            android:id="@+id/openConsoleButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Open LoggerBuddy Console" />

        <Button
            android:id="@+id/clearLogsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Clear Logs" />

    </LinearLayout>
</ScrollView>