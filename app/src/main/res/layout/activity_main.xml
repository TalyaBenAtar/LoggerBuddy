<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LoggerBuddy"
            android:textColor="@color/demo_title_blue"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A developer console for Android apps"
            android:textColor="@color/demo_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Demo app actions"
            android:textColor="@color/demo_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Simulate Login"
            android:textColor="@color/demo_text_primary" />

        <Button
            android:id="@+id/loadDataButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Simulate Loading Data"
            android:textColor="@color/demo_text_primary" />

        <Button
            android:id="@+id/warningButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Simulate Warning"
            android:textColor="@color/demo_text_primary" />

        <Button
            android:id="@+id/errorButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Simulate Error"
            android:textColor="@color/demo_text_primary" />

        <Button
            android:id="@+id/crashButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/demo_button_blue"
            android:textColor="@color/demo_text_primary"
            android:text="Crash App (Test)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Manual log"
            android:textColor="@color/demo_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/demo_input_blue"
            android:hint="Write a custom log message"
            android:minLines="2"
            android:singleLine="false"
            android:textColor="@color/demo_text_primary"
            android:textColorHint="@color/demo_text_hint" />

        <EditText
            android:id="@+id/tagEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/demo_input_blue"
            android:hint="Tag, example: MainActivity"
            android:singleLine="true"
            android:textColor="@color/demo_text_primary"
            android:textColorHint="@color/demo_text_hint" />

        <RadioGroup
            android:id="@+id/levelRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/infoRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="INFO"
                android:textColor="@color/demo_log_info" />

            <RadioButton
                android:id="@+id/warningRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARNING"
                android:textColor="@color/demo_log_warning" />

            <RadioButton
                android:id="@+id/errorRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ERROR"
                android:textColor="@color/demo_log_error" />

            <RadioButton
                android:id="@+id/debugRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEBUG"
                android:textColor="@color/demo_log_debug" />
        </RadioGroup>

        <Button
            android:id="@+id/addLogButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Add Log"
            android:textColor="@color/demo_text_on_button" />

        <Button
            android:id="@+id/openConsoleButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/demo_button_blue"
            android:text="Open LoggerBuddy Console"
            android:textColor="@color/demo_text_on_button" />

    </LinearLayout>
</ScrollView>